<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Sale Config Settings Inherit -->
   <record id="res_config_settings_view_form_inherit_product_threshold" model="ir.ui.view">
       <field name="name">res.config.settings.view.form.inherit.product.threshold</field>
       <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="base.res_config_settings_view_form"/>
       <field name="arch" type="xml">
           <xpath expr="//app[@name='general_settings']" position="inside">
               <block title="Product Threshold Settings">
                   <setting string="Set the product threshold">
                       <field name="product_threshold"/>
                   </setting>
               </block>
           </xpath>
       </field>
   </record>
</odoo>
